/Names <</JavaScript <</Names [(Placeholder_Toggle) <</S /JavaScript
/JS (function runPlaceholderToggle\(isChecked\) {\r\n    var IDX_NAME = 2;\r\n    var IDX_TYPE = 4;\r\n    var IDX_PLACEHOLDER = 11;\r\n\r\n    // Use fields.length to know when to stop\r\n    for \(var i = 0; i < fields.length; i++\) {\r\n        // Use fieldsIndex\(i\) correctly as a function\r\n        var fData = fieldsIndex\(i\); \r\n        \r\n        if \(fData && fData.length > IDX_PLACEHOLDER\) {\r\n            var fName = fData[IDX_NAME];\r\n            var fType = fData[IDX_TYPE];\r\n            var fRealPlaceholder = fData[IDX_PLACEHOLDER];\r\n\r\n            if \(fType === "text" && fRealPlaceholder !== "N/A" && fRealPlaceholder !== ""\) {\r\n                var fObj = this.getField\(fName\);\r\n                if \(fObj\) {\r\n                    if \(isChecked\) {\r\n                        // --- TURN ON ---\r\n                        fObj.defaultValue = fRealPlaceholder;\r\n                        // Replace empty or old "defaultValue" string\r\n                        if \(fObj.value === "" || fObj.value === "defaultValue"\) {\r\n                            fObj.value = fRealPlaceholder;\r\n                        }\r\n                    } else {\r\n                        // --- TURN OFF ---\r\n                        if \(fObj.value === fRealPlaceholder\) {\r\n                            fObj.value = "";\r\n                        }\r\n                        fObj.defaultValue = "";\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n})
>> (Visibilidad_Botones) <</S /JavaScript
/JS (var isAcrobat = app.viewerType === "Nitro-Pro" || \r\n                app.viewerType === "Acrobat" || \r\n                app.viewerType === "Reader" || \r\n                app.viewerType === "Foxit" || \r\n                app.viewerType === "PDF-XChange" || \r\n                app.viewerType === "Wondershare";\r\n\r\nvar buttonNames = [\r\n    "exportar",\r\n    "importar",\r\n];\r\n\r\nbuttonNames.forEach\(function\(buttonName\) {\r\n    var button = this.getField\(buttonName\);\r\n    if \(isAcrobat\) {\r\n        button.display = display.visible;\r\n        button.readonly = false;\r\n    } else {\r\n        button.display = display.hidden;\r\n        button.readonly = true;\r\n    }\r\n}, this\);)
>> (fieldsIndex) <</S /JavaScript
